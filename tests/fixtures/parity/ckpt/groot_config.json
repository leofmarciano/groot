  "rope_theta": 160000.0,
  "norm_eps": 1e-05,
  "dropout": 0.1,
  "scorer_hidden": null,
  "conf_hidden": 256,
  "temperature_init": 1.0,
  "qtypes": [
    "choice",
    "score",
    "noul"
  ],
  "dtype": "float32",
  "organization": "Marciano Theory SI",
  "family": "Groot",
  "version": "1"
}
